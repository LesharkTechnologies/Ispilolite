# ---------------------------------------------------------------------------
# Ispilolite environment template.
# Copy to .env and replace every <...> placeholder. Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime ---
ENVIRONMENT=production
PORT=8001
CONFIG_PATH=config/config.yaml

# --- Auth / JWT (REQUIRED in production; no development fallback) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=<generate-a-strong-random-secret>
JWT_ISSUER=ispilolite
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- OTP storage hashing ---
# Keyed hash (HMAC-SHA256) applied to verification codes stored in Redis so
# plaintext codes are never persisted. Falls back to JWT_SECRET when unset.
# Rotating this key immediately invalidates every outstanding OTP.
OTP_HASH_KEY=<generate-a-strong-random-secret>

# --- Super Admin Account (Environment Provisioned) ---
# Username and password used by administrators and audit officers to sign in with full system/DB access.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<generate-a-strong-admin-password>
ADMIN_EMAIL=admin@ispilo.co.ke
ADMIN_PHONE=+254700000000

# --- Database (writer + reader) ---
# DATABASE_URL takes precedence over the host/user fields in config/config.yaml.
DATABASE_URL=postgres://ispilo:<db-password>@localhost:5432/ispilolite?sslmode=disable
DATABASE_READ_URL=postgres://ispilo:<db-password>@localhost:5432/ispilolite?sslmode=disable
DB_WRITER_MAX_CONNS=25
DB_READER_MAX_CONNS=50
# Use "require" or "verify-full" for remote databases. "disable" is accepted in
# production only when the host resolves to loopback (single-VPS topology).
DB_SSL_MODE=require

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Search (Elasticsearch fast path + Postgres fallback) ---
ES_ADDRESSES=
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_ENABLED=false
ES_ENABLE_SNIFF=false
ES_MAX_RETRIES=2
ES_REQUEST_TIMEOUT=800ms
ES_FALLBACK_TIMEOUT=2s
ES_BREAKER_THRESHOLD=5
ES_BREAKER_COOLDOWN=15s
# Allowed: es_first | pg_first | es_only | pg_only
ES_FALLBACK_STRATEGY=es_first
ES_ENSURE_INDICES=true
ES_SYNC_INTERVAL=5m
ES_LOCATION_SYNC_LIMIT=500

# --- Public profile share links ---
# Origin only (no path). Stored profile paths stay valid across domain changes.
# Defaults to https://lite.ispilo.co.ke in production.
PROFILE_PUBLIC_BASE_URL=https://lite.ispilo.co.ke
QUOTATION_PUBLIC_BASE_URL=https://quotations.ispilo.co.ke

# Salt used to hash anonymous ad viewers. Set a stable random value so unique
# audience counts do not inflate after every restart. Falls back to JWT_SECRET.
PROMOTION_VIEWER_SALT=<generate-a-strong-random-secret>

# --- Cloudinary (API signs uploads; clients upload directly) ---
# API key is public in signed upload params. API secret is server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=ispilolite
CLOUDINARY_ALLOWED_HOSTS=res.cloudinary.com

# --- Escrow payment providers ---
# Use the Daraja sandbox URL in staging, production only after approval.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://lite.ispilo.co.ke/api/v1/payments/webhooks/mpesa

AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_URL=https://lite.ispilo.co.ke/api/v1/payments/webhooks/airtel
PAYMENT_WEBHOOK_SECRET=<generate-a-strong-random-secret>

# --- SMS (Talksasa v3) ---
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3
TALKSASA_API_TOKEN=
TALKSASA_SENDER_ID=TALKSASA
OTP_TTL=10m
ADMIN_ALERT_PHONES=

# --- Message queue ---
RABBITMQ_URL=amqp://ispilo:<rabbitmq-password>@localhost:5672/
RABBITMQ_REQUIRED=false
RABBITMQ_CONSUMER_NAME=ispilolite-api
RABBITMQ_PREFETCH=20
# The notification worker exits if this is empty.
NOTIFICATION_WEBHOOK_URL=
# Push events contain registered FCM/APNs/web tokens. The configured HTTPS
# delivery gateway must authenticate this bearer token.
NOTIFICATION_WEBHOOK_TOKEN=<generate-a-strong-random-secret>
MONITORING_ADDR=:9091

# --- CORS (restrict to your Flutter web domain in production) ---
CORS_ALLOWED_ORIGINS=https://lite.ispilo.co.ke

# --- Proxy / client IP ---
# Only these peers may set X-Forwarded-For. Defaults to loopback (Nginx on the
# same VPS). Use comma-separated CIDRs when the proxy lives elsewhere.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Storage / audit ---
DOCUMENT_STORAGE_ROOT=storage/documents
AUDIT_ARCHIVE_ROOT=storage/audit

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Protects /metrics. Leave empty to return 404 in production.
METRICS_TOKEN=<generate-a-strong-random-secret>

# --- Docker compose only (not read by the Go binaries) ---
POSTGRES_USER=ispilo
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=ispilolite
RABBITMQ_USER=ispilo
RABBITMQ_PASSWORD=<rabbitmq-password>
GRAFANA_USER=admin
GRAFANA_PASSWORD=<generate-a-strong-random-secret>
