# Copy to .env and run with: node --env-file=.env your-script.js
# Never expose PALPLUSS_API_KEY to the Flutter app or commit it.

# Confirm the base URL in the Palpluss dashboard/docs before deploying.
PALPLUSS_BASE_URL=https://api.palpluss.com
PALPLUSS_API_KEY=<your-api-key>
# The Go backend registers only mpesa/airtel providers today; add a Palpluss
# provider before switching callbacks to this path.
PALPLUSS_CALLBACK_URL=https://lite.ispilo.co.ke/api/v1/payments/webhooks/palpluss
PALPLUSS_CHANNEL_ID=
PALPLUSS_TIMEOUT_MS=15000
