# Copy to /etc/ispilolite/backup.env and chmod 600 (root-owned).
# This file is read by systemd, not by the Go services.

# Dedicated backup role: SELECT on the database plus pg_read_all_data.
DATABASE_URL=postgres://ispilo_backup:<backup-password>@127.0.0.1:5432/ispilolite?sslmode=disable

BACKUP_DIR=/var/backups/ispilolite
BACKUP_RETENTION_DAYS=30

# Offsite: any rclone remote (S3, B2, GCS, SFTP, ...). Leave empty to disable.
BACKUP_OFFSITE_REMOTE=
# The production systemd timer fails rather than claiming success locally
# when offsite upload is not configured.
BACKUP_OFFSITE_REQUIRED=true
# Encrypt the offsite copy with an operator GPG key (recommended).
BACKUP_GPG_RECIPIENT=
# Textfile metrics consumed by node-exporter and the IspiloliteBackupStale rule.
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/ispilo_backup.prom
